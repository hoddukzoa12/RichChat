# 로컬에서는 `cp .dev.vars.example .dev.vars`로 복사한 뒤 필요한 값을 채운다.
# 운영 시크릿은 이 파일이 아니라 `wrangler secret put <이름>`으로 등록한다.
# `vars`는 Cloudflare 대시보드에 평문으로 보이므로 시크릿을 넣지 않는다.
# 웹훅 시크릿을 회전할 때는 LGU+ 관리자콘솔의 URL도 함께 바꿔야 하며,
# 변경이 맞물리지 않는 동안 MO 수신 또는 발송 리포트 수신이 끊긴다.

# 발급: 없음 — 우리가 설정하는 개발 로그인 스위치다.
# 설정: 로컬 개발 로그인이 필요할 때만 `true`를 직접 입력한다.
# 미설정 시: 개발용 로그인이 닫힌다. 정확히 문자열 `true`일 때만 열리고 그 외에는 모두 닫힌다.
# 경고: 운영에서는 절대 `true`로 설정하지 않는다.
DEV_LOGIN_ENABLED=

# 발급: 없음 — 우리가 정하는 현재 LGU+ 연동 환경 이름이다.
# 설정: 배포 환경에 맞춰 `local`, `qa`, `production` 같은 식별자를 입력한다.
# 미설정 시: 상태 확인 응답에서 LGU+ 연동 환경을 구분할 수 없다.
LGU_ENV=

# 발급: LGU+가 연동 환경별 인증 API 호스트를 제공한다.
# 확인: LGU+ 메시지허브 관리자콘솔의 프로젝트별 API 연동 정보 또는 연동 문서에서 확인한다.
# 미설정 시: 액세스 토큰을 발급할 수 없어 문자 발송과 발송 리포트 보정이 동작하지 않는다.
LGU_AUTH_HOST=

# 발급: LGU+가 연동 환경별 발송 API 호스트를 제공한다.
# 확인: LGU+ 메시지허브 관리자콘솔의 프로젝트별 API 연동 정보 또는 연동 문서에서 확인한다.
# 미설정 시: SMS/LMS 발송 요청을 보낼 수 없다.
LGU_SEND_HOST=

# 발급: LGU+가 연동 환경별 콘텐츠 API 호스트를 제공한다.
# 확인: LGU+ 메시지허브 관리자콘솔의 프로젝트별 API 연동 정보 또는 연동 문서에서 확인한다.
# 미설정 시: MMS/MO 첨부파일을 내려받을 수 없다.
LGU_CONTENT_HOST=

# 발급: 네이버웍스가 앱을 등록할 때 발급한다.
# 확인: 네이버웍스 Developer Console > 앱 목록 > 대상 앱의 Client ID에서 확인한다.
# 미설정 시: 네이버웍스 OIDC 로그인을 시작할 수 없다.
WORKS_CLIENT_ID=

# 발급: 네이버웍스가 제공하는 OIDC 발급자 주소다.
# 확인: 네이버웍스 OIDC 문서와 대상 앱의 인증 설정에서 확인한다.
# 미설정 시: OIDC discovery 문서를 불러올 수 없어 네이버웍스 로그인이 동작하지 않는다.
WORKS_ISSUER=

# 발급: 네이버웍스가 고객사 테넌트에 부여한다.
# 확인: 네이버웍스 Developer Console > 앱 목록 > 대상 앱의 인증 설정에서 확인한다.
# 미설정 시: 해당 테넌트의 OIDC discovery 문서를 찾을 수 없어 네이버웍스 로그인이 동작하지 않는다.
WORKS_TENANT_ID=

# 발급: Cloudflare Zero Trust > Access > 서비스 토큰에서 발급한다.
# 확인: 생성된 서비스 토큰의 Client ID에서 확인한다.
# 미설정 시: 사무실 LGU+ 터널과 SMS Gateway 관리 경로의 Cloudflare Access를 통과할 수 없어 관련 API 요청이 차단된다.
CF_ACCESS_CLIENT_ID=

# 발급: Cloudflare Zero Trust > Access > 서비스 토큰에서 Client ID와 함께 발급한다.
# 확인: Client Secret은 서비스 토큰 생성 시점에 한 번만 표시되므로 즉시 안전하게 보관한다.
# 미설정 시: 사무실 LGU+ 터널과 SMS Gateway 관리 경로의 Cloudflare Access를 통과할 수 없어 관련 API 요청이 차단된다.
CF_ACCESS_CLIENT_SECRET=

# 발급: LGU+가 프로젝트의 API 연동 정보를 만들 때 발급한다.
# 확인: LGU+ 메시지허브 관리자콘솔 > 프로젝트 상세 > 기본정보의 API KEY에서 확인한다.
# 미설정 시: LGU+ 액세스 토큰을 발급할 수 없어 문자 발송과 발송 리포트 보정이 동작하지 않는다.
LGU_API_KEY=

# 발급: LGU+가 프로젝트의 API 연동 정보와 함께 발급한다.
# 확인: LGU+ 메시지허브 관리자콘솔 > 프로젝트 상세 > 기본정보의 API 비밀번호에서 확인한다.
# 미설정 시: LGU+ 액세스 토큰을 발급할 수 없어 문자 발송과 발송 리포트 보정이 동작하지 않는다.
LGU_API_PASSWORD=

# 발급: LGU+가 아니라 우리가 URL 안전 문자로 생성한다.
# 생성: `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`
# 등록: 문서에 MO 등록 절차·화면이 없으므로 LGU+에 문의해 창구를 확인한 뒤 `https://<도메인>/api/hooks/lgu/mo/<생성한값>` 전체를 등록한다.
# 미설정 시: LGU+가 보낸 SMS/MMS MO 웹훅을 인증해 수신할 수 없다.
LGU_MO_WEBHOOK_SECRET=

# 발급: LGU+가 아니라 우리가 URL 안전 문자로 생성한다.
# 생성: `openssl rand -base64 32 | tr '+/' '-_' | tr -d '='`
# 등록: 관리자콘솔 > 프로젝트 상세 > API KEY > 수정 > 결과수신 방법 Webhook에 `https://<도메인>/api/hooks/lgu/report/<생성한값>` 전체를 입력한다.
# 미설정 시: LGU+ 발송 결과 웹훅을 인증해 수신할 수 없어 메시지 도달 상태를 갱신할 수 없다.
LGU_REPORT_WEBHOOK_SECRET=

# 발급: 없음 — 사무실 SMS Gateway 관리 API의 기준 주소다.
# 설정: 같은 오리진의 `/api/3rdparty/v1/*`를 Cloudflare Access로 보호한 뒤, `https://<게이트웨이>/api/3rdparty/v1` 전체를 입력한다.
# 미설정 시: 업무폰 문자 발송이 실패로 기록된다.
SMS_GATEWAY_API_URL=

# 발급: 없음 — 업무폰 앱이 직접 접속할 주소이며 관리 API와 **호스트가 다르다.**
# 설정: Access를 걸지 않은 공개 호스트로 `https://<게이트웨이>/api/mobile/v1`까지 입력한다. 외근 나간 폰이 붙어야 하므로 사내망 전용 주소를 넣으면 안 된다.
# 미설정 시: 업무폰 등록 코드를 발급할 수 없다. 관리 API 주소를 대신 쓰면 Access가 폰을 403으로 막아 영원히 등록되지 않는다.
SMS_GATEWAY_MOBILE_URL=

# 발급: Android SMS Gateway 관리 API 계정에서 발급한다. 기기 등록용 PRIVATE_TOKEN은 넣지 않는다.
# 확인: 관리 API의 HTTP Basic 인증 계정 아이디다.
# 미설정 시: 업무폰에 묶인 대화의 문자 발송이 실패로 기록되고, 등록 코드 발급·기기 자동 감지가 동작하지 않는다.
SMS_GATEWAY_USERNAME=

# 발급: Android SMS Gateway 관리 API 계정에서 발급한다.
# 확인: 관리 API의 HTTP Basic 인증 계정 비밀번호다.
# 미설정 시: 업무폰에 묶인 대화의 문자 발송이 실패로 기록되고, 등록 코드 발급·기기 자동 감지가 동작하지 않는다.
SMS_GATEWAY_PASSWORD=

# 발급: 네이버웍스가 앱을 등록할 때 발급한다.
# 확인: 네이버웍스 Developer Console > 앱 목록 > 대상 앱의 Client Secret에서 확인한다.
# 미설정 시: OIDC 인가 코드를 토큰으로 교환할 수 없어 네이버웍스 로그인이 완료되지 않는다.
WORKS_CLIENT_SECRET=
