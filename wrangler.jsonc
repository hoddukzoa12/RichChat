{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "richchat",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-07-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "routes": [
    {
      "pattern": "chat.rich-group.kr",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist/",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "vars": {
    "DEV_LOGIN_ENABLED": "false",
    "LGU_ENV": "production",
    "LGU_AUTH_HOST": "lgu-auth.rich-group.kr", // → api.msghub.uplus.co.kr
    "LGU_SEND_HOST": "lgu-send.rich-group.kr", // → api-send.msghub.uplus.co.kr
    "LGU_CONTENT_HOST": "lgu-file.rich-group.kr", // → mnt-api.msghub.uplus.co.kr
    "SMS_GATEWAY_API_URL": "https://sms-api.rich-group.kr/api/3rdparty/v1",
    "WORKS_CLIENT_ID": "V6MgQwNfZoK8fnESzNZy",
    "WORKS_ISSUER": "https://auth.worksmobile.com",
    "WORKS_TENANT_ID": "300285491"
  },
  "secrets": {
    "required": [
      "CF_ACCESS_CLIENT_ID",
      "CF_ACCESS_CLIENT_SECRET",
      "LGU_API_KEY",
      "LGU_API_PASSWORD",
      "LGU_MO_WEBHOOK_SECRET",
      "LGU_REPORT_WEBHOOK_SECRET",
      "SMS_GATEWAY_PASSWORD",
      "SMS_GATEWAY_SIGNING_KEYS",
      "SMS_GATEWAY_USERNAME",
      "WORKS_CLIENT_SECRET"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "richchat",
      "database_id": "486256bf-b4ec-47ca-ae44-5af82de40095"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ATTACHMENTS",
      "bucket_name": "richchat-attachments"
    }
  ],
  "triggers": {
    "crons": ["*/1 * * * *"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "OFFICE_HUB",
        "class_name": "OfficeHub"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["OfficeHub"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
